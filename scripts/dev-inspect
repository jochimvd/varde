#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=dev-common
source "$repo_dir/scripts/dev-common"

session=default
while (( $# > 0 )); do
    case $1 in
        --session)
            if (( $# < 2 )); then
                printf 'missing value for --session\n' >&2
                exit 1
            fi
            session=$2
            shift
            ;;
        *)
            printf 'usage: %s [--session ID]\n' "$0" >&2
            exit 1
            ;;
    esac
    shift
done

varde_dev_select_session "$session"
varde_dev_load_session

monitors=$(hyprctl -i "$VARDE_DEV_INSTANCE" -j monitors)
layers=$(hyprctl -i "$VARDE_DEV_INSTANCE" -j layers)
clients=$(hyprctl -i "$VARDE_DEV_INSTANCE" -j clients)

jq -n \
    --arg instance "$VARDE_DEV_INSTANCE" \
    --arg session "$session" \
    --arg wayland_display "$VARDE_DEV_WAYLAND_DISPLAY" \
    --argjson monitors "$monitors" \
    --argjson layers "$layers" \
    --argjson clients "$clients" \
    '{session: $session, instance: $instance, wayland_display: $wayland_display, monitors: $monitors, layers: $layers, clients: $clients}'
