#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=dev-common
source "$repo_dir/scripts/dev-common"

usage() {
    printf 'Usage: %s [OPTIONS] --focus\n\n' "$0"
    printf 'Options:\n'
    printf '  --session ID  Target session [default: default]\n'
    printf '  --focus       Switch to the session host workspace\n'
    printf '  -h, --help    Print help\n'
}

session=default
focus=false
while (( $# > 0 )); do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        --focus)
            focus=true
            ;;
        --session)
            if (( $# < 2 )); then
                printf 'missing value for --session\n' >&2
                exit 1
            fi
            session=$2
            shift
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
    shift
done

if [[ $focus != true ]]; then
    printf 'dev-show changes the active workspace; rerun with --focus to confirm\n' >&2
    exit 1
fi

varde_dev_select_session "$session"
varde_dev_load_session

hyprctl -i "$VARDE_DEV_HOST_INSTANCE" dispatch \
    "hl.dsp.focus({ workspace = 'name:$VARDE_DEV_HOST_WORKSPACE' })" >/dev/null
