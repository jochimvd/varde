varde_dev_select_session() {
    local session=$1

    if [[ ! $session =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
        printf 'invalid session ID: %s (expected [a-z][a-z0-9-]{0,31})\n' "$session" >&2
        exit 1
    fi

    VARDE_DEV_SESSION_ID=$session
    VARDE_DEV_RUNTIME_DIR=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/varde-dev/$session
    VARDE_DEV_SESSION_FILE=$VARDE_DEV_RUNTIME_DIR/session
}

varde_dev_load_session() {
    if [[ ! -f $VARDE_DEV_SESSION_FILE ]]; then
        printf 'no Varde dev session %s is running; start scripts/dev-session --session %s first\n' \
            "$VARDE_DEV_SESSION_ID" "$VARDE_DEV_SESSION_ID" >&2
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$VARDE_DEV_SESSION_FILE"
    if ! kill -0 "$VARDE_DEV_PID" 2>/dev/null ||
        ! hyprctl -j instances | jq -e \
            --arg instance "$VARDE_DEV_INSTANCE" \
            --argjson pid "$VARDE_DEV_PID" \
            '.[] | select(.instance == $instance and .pid == $pid)' >/dev/null; then
        printf 'the recorded Varde dev session %s is no longer running\n' \
            "$VARDE_DEV_SESSION_ID" >&2
        exit 1
    fi
}
