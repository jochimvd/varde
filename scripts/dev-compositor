#!/usr/bin/env bash
set -euo pipefail

if (( $# < 2 )); then
    printf 'usage: %s PID_FILE WORK_DIR [HYPRLAND_ARGUMENTS...]\n' "$0" >&2
    exit 1
fi

pid_file=$1
work_dir=$2
shift 2
pid_tmp="$pid_file.$$"

cleanup() {
    rm -f -- "$pid_tmp"
}
trap cleanup EXIT

umask 077
mkdir -p "$work_dir"
cd "$work_dir"
printf '%s\n' "$$" >"$pid_tmp"
mv -- "$pid_tmp" "$pid_file"
exec Hyprland "$@"
