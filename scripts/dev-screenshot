#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=dev-common
source "$repo_dir/scripts/dev-common"

session=default
output_file=
while (( $# > 0 )); do
    case $1 in
        --session)
            if (( $# < 2 )); then
                printf 'missing value for --session\n' >&2
                exit 1
            fi
            session=$2
            shift
            ;;
        --)
            shift
            if (( $# != 1 )) || [[ -n $output_file ]]; then
                printf 'usage: %s [--session ID] [OUTPUT]\n' "$0" >&2
                exit 1
            fi
            output_file=$1
            break
            ;;
        -*)
            printf 'usage: %s [--session ID] [OUTPUT]\n' "$0" >&2
            exit 1
            ;;
        *)
            if [[ -n $output_file ]]; then
                printf 'usage: %s [--session ID] [OUTPUT]\n' "$0" >&2
                exit 1
            fi
            output_file=$1
            ;;
    esac
    shift
done

shell_dev_select_session "$session"
output_file=${output_file:-$repo_dir/target/dev/$session/screenshot.png}

command -v grim >/dev/null || {
    printf 'missing required command: grim\n' >&2
    exit 1
}

shell_dev_load_session

mkdir -p "$(dirname -- "$output_file")"
WAYLAND_DISPLAY=$SHELL_DEV_WAYLAND_DISPLAY \
HYPRLAND_INSTANCE_SIGNATURE=$SHELL_DEV_INSTANCE \
    grim -o "$SHELL_DEV_OUTPUT" "$output_file"

printf '%s\n' "$output_file"
