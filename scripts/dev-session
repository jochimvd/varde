#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=dev-common
source "$repo_dir/scripts/dev-common"

usage() {
    printf 'Usage: %s [OPTIONS]\n\n' "$0"
    printf 'Options:\n'
    printf '  --session ID  Use a named session [default: default]\n'
    printf '  --release     Build and run the release profile\n'
    printf '  --cairo       Use the GTK Cairo renderer\n'
    printf '  -h, --help    Print help\n'
}

session=default
profile=debug
build_args=()
renderer=

while (( $# > 0 )); do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        --release)
            profile=release
            build_args+=(--release)
            ;;
        --cairo)
            renderer=cairo
            ;;
        --session)
            if (( $# < 2 )); then
                printf 'missing value for --session\n' >&2
                exit 1
            fi
            session=$2
            shift
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
    shift
done

varde_dev_select_session "$session"

for command in cargo dbus-daemon flock Hyprland hyprctl jq; do
    command -v "$command" >/dev/null || {
        printf 'missing required command: %s\n' "$command" >&2
        exit 1
    }
done

if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    printf 'dev-session must be started from an existing Wayland session\n' >&2
    exit 1
fi

host_instance=${HYPRLAND_INSTANCE_SIGNATURE:?dev-session must be started from Hyprland}
if ! hyprctl -j instances | jq -e --arg instance "$host_instance" \
    '.[] | select(.instance == $instance)' >/dev/null; then
    printf 'the terminal has a stale Hyprland instance signature; open a new terminal and retry\n' >&2
    exit 1
fi

mkdir -p "$VARDE_DEV_RUNTIME_DIR"
exec {lock_fd}>"$VARDE_DEV_RUNTIME_DIR/lock"
if ! flock -n "$lock_fd"; then
    printf 'Varde dev session %s is already running\n' "$session" >&2
    exit 1
fi
rm -f -- "$VARDE_DEV_SESSION_FILE"

cargo build "${build_args[@]}" --manifest-path "$repo_dir/Cargo.toml"

compositor_pid=
bus_pid=
bus_socket="$VARDE_DEV_RUNTIME_DIR/bus"
launcher_pid_file="$VARDE_DEV_RUNTIME_DIR/compositor-pid"
metadata_tmp="$VARDE_DEV_SESSION_FILE.$$"

cleanup() {
    if [[ -n $compositor_pid ]] && kill -0 "$compositor_pid" 2>/dev/null; then
        kill "$compositor_pid"
    fi
    if [[ -n $bus_pid ]] && kill -0 "$bus_pid" 2>/dev/null; then
        kill "$bus_pid"
    fi
    rm -f -- "$bus_socket" "$launcher_pid_file" "$metadata_tmp" "$VARDE_DEV_SESSION_FILE"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rm -f -- "$bus_socket"
bus_info=$(dbus-daemon --session --fork --address="unix:path=$bus_socket" \
    --print-address=1 --print-pid=1)
bus_address=${bus_info%%$'\n'*}
bus_pid=${bus_info##*$'\n'}
if [[ -z $bus_address || ! $bus_pid =~ ^[0-9]+$ ]]; then
    printf 'failed to start the development D-Bus session\n' >&2
    exit 1
fi

renderer_env=
if [[ -n $renderer ]]; then
    renderer_env=" GSK_RENDERER=$renderer"
fi
debug_layout_env=
if [[ ${VARDE_DEBUG_LAYOUT:-} == 1 ]]; then
    debug_layout_env=" VARDE_DEBUG_LAYOUT=1"
fi
application_id="org.varde.desktop.Development.${session//-/_}"
host_workspace="varde-dev-$session"
work_dir="$VARDE_DEV_RUNTIME_DIR/work"
rm -f -- "$launcher_pid_file"
launch_command="env VARDE_NOTIFICATION_BUS_ADDRESS=$bus_address VARDE_DEV_APP_ID=$application_id VARDE_DEV_BINARY=$repo_dir/target/$profile/varde$renderer_env$debug_layout_env HYPRLAND_NO_SD_NOTIFY=1 HYPRLAND_NO_SD_VARS=1 $repo_dir/scripts/dev-compositor $launcher_pid_file $work_dir --config $repo_dir/dev/hyprland.lua"
hyprctl -i "$host_instance" eval \
    "hl.dispatch(hl.dsp.exec_cmd('$launch_command', { \
float = true, size = { 1280, 720 }, center = true, \
workspace = 'name:$host_workspace silent', no_initial_focus = true, \
    no_anim = true, render_unfocused = true }))" >/dev/null

instance=
for _ in {1..100}; do
    if [[ ! -f $launcher_pid_file ]]; then
        sleep 0.05
        continue
    fi
    compositor_pid=$(<"$launcher_pid_file")
    if [[ ! $compositor_pid =~ ^[0-9]+$ ]]; then
        printf 'nested Hyprland launcher wrote an invalid pid\n' >&2
        exit 1
    fi
    new_instance=$(hyprctl -j instances | jq -c --argjson pid "$compositor_pid" \
        '.[] | select(.pid == $pid)' | head -n 1)
    if [[ -n $new_instance ]]; then
        instance=$(jq -r '.instance' <<<"$new_instance")
        break
    fi
    sleep 0.05
done

if [[ -z $instance || -z $compositor_pid ]]; then
    printf 'timed out waiting for the nested Hyprland instance\n' >&2
    exit 1
fi

wayland_display=$(jq -r '.wl_socket' <<<"$new_instance")

output=
for _ in {1..100}; do
    output=$(hyprctl -i "$instance" -j monitors | jq -r '.[0].name // empty')
    [[ -n $output ]] && break
    sleep 0.05
done

if [[ -z $output ]]; then
    printf 'timed out waiting for the nested Hyprland output\n' >&2
    exit 1
fi

umask 077
printf 'VARDE_DEV_PID=%q\nVARDE_DEV_INSTANCE=%q\nVARDE_DEV_WAYLAND_DISPLAY=%q\nVARDE_DEV_OUTPUT=%q\nVARDE_DEV_HOST_INSTANCE=%q\nVARDE_DEV_HOST_WORKSPACE=%q\nVARDE_DEV_APP_ID=%q\nVARDE_DEV_WORK_DIR=%q\nVARDE_DEV_DBUS_ADDRESS=%q\nVARDE_DEV_DBUS_PID=%q\nVARDE_DEV_PROFILE=%q\nVARDE_DEV_RENDERER=%q\n' \
    "$compositor_pid" "$instance" "$wayland_display" "$output" "$host_instance" \
    "$host_workspace" "$application_id" "$work_dir" "$bus_address" "$bus_pid" \
    "$profile" "$renderer" >"$metadata_tmp"
mv -- "$metadata_tmp" "$VARDE_DEV_SESSION_FILE"

printf 'Nested Hyprland is ready.\n'
printf '  session:  %s\n' "$session"
printf '  instance: %s\n' "$instance"
printf '  output:   %s (1280x720)\n' "$output"
printf '  work dir: %s\n' "$work_dir"
printf '  profile:  %s\n' "$profile"
printf '  renderer: %s\n' "${renderer:-default}"
printf '  show:     scripts/dev-show --session %s --focus\n' "$session"
printf '  inspect:  scripts/dev-inspect --session %s\n' "$session"
printf '  capture:  scripts/dev-screenshot --session %s\n' "$session"
printf 'Press Ctrl+Alt+Escape inside the nested session to stop it.\n'

while kill -0 "$compositor_pid" 2>/dev/null; do
    sleep 0.25
done
